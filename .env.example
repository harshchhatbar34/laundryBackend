# ─── Server ────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ───────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/laundry_db

# ─── JWT ───────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=30d

# ─── Super Admin Seed ──────────────────────────────
# Used only in seed script to bootstrap the first superadmin account
SUPERADMIN_EMAIL=superadmin@laundry.com
SUPERADMIN_PASSWORD=SuperAdmin@2026

# ─── SMTP Email Configuration ──────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your16characterapppassword
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Qwasho
FRONTEND_URL=http://localhost:5000

# ─── Firebase Admin SDK ────────────────────────────
# In production (Vercel): paste the entire firebase-service-account.json content here as a single line
# In local development: leave this empty and place firebase-service-account.json in src/config/
FIREBASE_SERVICE_ACCOUNT_JSON=
